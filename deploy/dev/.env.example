# Copy to deploy/dev/.env and replace every value. .env is git-ignored; never commit it.
POSTGRES_PASSWORD=change-me
NEWSPILOT_OWNER_PASSWORD=change-me-too
NEWSPILOT_APP_PASSWORD=and-change-me

# For the engine (export these in your shell, or put them in your own git-ignored env file):
# NEWSPILOT_MIGRATION_DATABASE_URL=postgresql://newspilot_owner:<owner password>@127.0.0.1:5432/newspilot
# NEWSPILOT_DATABASE_URL=postgresql://newspilot_app:<app password>@127.0.0.1:5432/newspilot
# NEWSPILOT_MASTER_KEY=<output of: newspilot secret new-master-key>
